# Copy this file to .env (never commit .env) or add the same names as GitHub Actions secrets.
# Every key is optional; more keys = more leaderboards and a faster scan.

# --- Solana data (without these the free public RPC is used: works, but slow)
# Free key from https://dashboard.helius.dev (~50x faster wallet history)
HELIUS_API_KEY=
# Or any other RPC URL (QuickNode, Triton, ...)
SOLANA_RPC_URL=

# --- Leaderboards and ready-made PnL
# https://www.solanatracker.io/data-api : KOL + top-trader boards, gem search, fast scans
SOLANATRACKER_API_KEY=
# https://gmgn.ai/ai : smart-money + KOL wallets, gem search
GMGN_API_KEY=
# https://fomoapi.io : unofficial API for the Fomo app leaderboard
FOMOAPI_KEY=

# --- Alerts when a tracked wallet buys
# Telegram: create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
